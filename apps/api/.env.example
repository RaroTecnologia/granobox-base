# Configuração da API Granobox

# Ambiente
NODE_ENV=production
PORT=3001

# Banco de dados
DATABASE_URL=postgresql://granobox:granobox123@granobox-db:5432/granobox
POSTGRES_PASSWORD=granobox123

# Autenticação JWT
JWT_SECRET=sua-chave-jwt-super-segura-aqui-min-32-caracteres
JWT_EXPIRES_IN=7d

# CORS - Domínios permitidos (separados por vírgula)
CORS_ORIGINS=https://granobox.com,https://www.granobox.com,https://app.granobox.com

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# AWS S3 (opcional)
AWS_ACCESS_KEY_ID=sua-access-key
AWS_SECRET_ACCESS_KEY=sua-secret-key
AWS_REGION=us-east-1
AWS_BUCKET=granobox-uploads