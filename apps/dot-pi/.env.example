# Granobox Dot Pi - Configuração

# API Granobox
GRANOBOX_API_KEY=dot_sua_api_key_aqui
GRANOBOX_API_URL=https://api.granobox.com.br

# Porta Serial
# Orange Pi Zero 2W: /dev/ttyS1
# Raspberry Pi: /dev/ttyAMA0 ou /dev/serial0
GRANOBOX_SERIAL_PORT=/dev/ttyS1

# Baud Rate do GM861
GRANOBOX_BAUD_RATE=9600

# Display (opcional)
GRANOBOX_DISPLAY_ENABLED=false
GRANOBOX_DISPLAY_TYPE=none  # none, gc9a01, ssd1306

# Log Level
GRANOBOX_LOG_LEVEL=info  # debug, info, warn, error

