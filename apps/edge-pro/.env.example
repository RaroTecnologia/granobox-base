# Configuração via variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores

# Device
TAGMENT_DEVICE_ID=edge-001
TAGMENT_DEVICE_VERSION=2.0.0

# Socket.IO
TAGMENT_SOCKETIO_SERVER_URL=https://api.tagment.com.br
TAGMENT_SOCKETIO_API_KEY=
TAGMENT_SOCKETIO_LOCAL_PORT=3000
TAGMENT_SOCKETIO_AGENT_FINGERPRINT=
TAGMENT_SOCKETIO_NAMESPACE=/agents
TAGMENT_SOCKETIO_RECONNECT_DELAY=5

# API HTTP
TAGMENT_API_HOST=0.0.0.0
TAGMENT_API_PORT=3001

# Display
TAGMENT_DISPLAY_ENABLED=true
TAGMENT_DISPLAY_SERVICE_URL=localhost:3006
TAGMENT_DISPLAY_TYPE=rgb

# Debug
TAGMENT_DEBUG=false

