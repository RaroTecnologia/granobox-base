# Porta do serviço
PORT=3002

# URL da API (para CORS - fallback)
API_URL=http://localhost:3000

# CORS - origins permitidas (separadas por vírgula)
# Em produção, configurar no easypanel.yml
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Cache de templates processados
CACHE_ENABLED=true
CACHE_MAX_SIZE=100

# Opcional: banco para templates (futuro)
# DATABASE_URL=postgresql://user:pass@host:5432/granobox
